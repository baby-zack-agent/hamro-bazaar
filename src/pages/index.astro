---
import Base from '../layouts/Base.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ListingCard from '../components/ListingCard.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import { getFeatured, getListings, getAnnouncements, categoryLabel } from '../lib/db.js';

const featured = getFeatured();
const listings = getListings();
const announcements = getAnnouncements().slice(0, 3);
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
---
<Base title="Home" tab="home">
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow" data-i18n="hero.eyebrow">Pittsburgh · Nepali + Indian community</div>
      <h1 data-i18n="hero.title">Every Nepali &amp; Indian service in Pittsburgh. One search.</h1>
      <p class="lead" data-i18n="hero.sub">Groceries, momo spots, mechanics, tax help, home care — listed by the community, free forever.</p>
      <form class="searchbar" action="/browse" method="get" id="home-search">
        <input type="search" name="q" data-i18n-ph="hero.searchPh" placeholder="What do you need?"
               aria-label="Search businesses" autocomplete="off" />
        <button class="btn btn-primary btn-lg" type="submit">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <span class="sr-only" data-i18n="hero.searchLabel">Search businesses</span>
        </button>
      </form>
      <div class="cards" id="search-results" style="margin-top:12px" hidden></div>
      <div class="survey-cta">
        <a class="btn btn-ghost" href="/survey"><span data-i18n="sv.cta">Take the 2-minute survey</span></a>
      </div>
    </section>

    <section class="block" style="padding-top:0">
      <h2 class="rv sec-title" data-i18n="sec.categories">Categories</h2>
      <CategoryGrid />
    </section>
  </div>

  <section class="block band">
    <div class="wrap">
      <h2 class="rv sec-title" data-i18n="sec.featured">Featured near you</h2>
      <div class="rail" id="featured-rail">
        {featured.map((l) => <ListingCard listing={l} />)}
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="block">
      <h2 class="rv sec-title">
        <span data-i18n="sec.announcements">Fresh announcements</span>
        &nbsp;·&nbsp;<a href="/announcements" data-i18n="sec.announcementsAll">View all</a>
      </h2>
      <div class="cards">
        {announcements.map((a) => <AnnouncementCard announcement={a} />)}
      </div>
    </section>

    <section class="block" style="padding-top:0">
      <div class="band-cta rv">
        <div class="eyebrow" data-i18n="band.title">Own a business?</div>
        <h2 data-i18n="own.title">List your business — free</h2>
        <p data-i18n="band.sub">Get listed in front of the whole community — free, and we do the work.</p>
        <div class="band-actions">
          <a class="btn btn-on-dark" href="/list-business"><span data-i18n="band.cta">List your business — free</span></a>
          <a class="btn btn-ghost-dark" href="/feature"><span data-i18n="band.feat">Get featured — $25/mo</span></a>
        </div>
      </div>
    </section>
  </div>

  <script id="hb-listings-data" type="application/json">{JSON.stringify(listings)}</script>
  <script>
    import { searchListings, categoryLabel } from '../lib/db.js';
    import { telLink, waLink, waGreeting } from '../lib/format.js';
    import { getLang, t } from '../lib/i18n.js';
    import { track, qlenBucket } from '../lib/analytics.js';

    const data = JSON.parse(document.getElementById('hb-listings-data').textContent);
    const form = document.getElementById('home-search');
    const input = form.querySelector('input[name="q"]');
    const results = document.getElementById('search-results');

    function cardHTML(l, lang) {
      const tel = telLink(l.phone);
      const wa = waLink(l.phone, waGreeting(l, lang));
      return `<article class="lcard${l.featured ? ' lcard-featured' : ''}">
        <div class="card-top"><span class="card-cat">${escapeHTML(categoryLabel(l.category, lang))}</span>
        <span class="badges">${l.featured ? `<span class="badge badge-gold">${t('badge.featured', lang)}</span>` : ''}${l.verified ? `<span class="badge badge-ok">${t('badge.verified', lang)}</span>` : ''}</span></div>
        <h3><a class="cardlink" href="/business/${l.id}">${escapeHTML(l.name)}</a></h3>
        ${l.address ? `<p class="card-addr">${escapeHTML(l.address)}</p>` : ''}
        <div class="card-actions">
          ${tel ? `<a class="btn btn-primary" href="${tel}" data-listing-id="${l.id}" data-track-context="card">${t('card.call', lang)}</a>` : `<span class="nophone">${t('card.noPhone', lang)}</span>`}
          ${wa ? `<a class="btn btn-ghost" href="${wa}" target="_blank" rel="noopener" data-listing-id="${l.id}" data-track-context="card">WhatsApp</a>` : ''}
        </div></article>`;
    }
    function escapeHTML(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function render() {
      const q = input.value.trim();
      const lang = getLang();
      if (!q) { results.hidden = true; results.innerHTML = ''; return; }
      const hits = searchListings(q).slice(0, 12);
      results.hidden = false;
      results.innerHTML = hits.length ? hits.map((l) => cardHTML(l, lang)).join('')
        : `<p>${t('browse.noResults', lang)} <a href="/browse">${t('browse.clearFilters', lang)}</a></p>`;
    }
    // Live filter; plain form submit still works without JS (GET /browse?q=).
    input.addEventListener('input', render);
    form.addEventListener('submit', (e) => {
      const q = input.value.trim();
      if (q) {
        track('search', { qlen: qlenBucket(q) }); // bucket only — raw query text never leaves the device
        e.preventDefault();
      }
    });
    document.addEventListener('hb:lang', render);
    // Announcement titles re-render on toggle (shared pattern).
    function renderAnn(lang) {
      let annData = [];
      try { annData = JSON.parse(document.getElementById('hb-ann-data').textContent); } catch {}
      document.querySelectorAll('[data-ann]').forEach((el) => {
        const row = annData.find((a) => a.id === el.getAttribute('data-ann'));
        const p = row && el.querySelector('p.atitle');
        if (p) p.textContent = row.title[lang] || row.title.en;
      });
    }
    document.addEventListener('hb:lang', (e) => renderAnn(e.detail.lang));
  </script>
  <script id="hb-ann-data" type="application/json">{JSON.stringify(getAnnouncements().slice(0, 3))}</script>
</Base>
