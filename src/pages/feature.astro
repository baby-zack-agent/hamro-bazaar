---
import Base from '../layouts/Base.astro';
import { getListings } from '../lib/db.js';

// Optional ?listing=<id> prefill when arriving from a business page.
const prefillId = (Astro.url.searchParams.get('listing') || '').slice(0, 60);
const nameMap = Object.fromEntries(getListings().map((l) => [l.id, l.name]));
---
<Base title="Feature my business">
  <div class="wrap">
    <section class="block">
      <h1 class="eyebrow" data-i18n="feat.title" style="margin-bottom:8px">Feature my business</h1>
      <p data-i18n="feat.sub" style="color:var(--ink-soft);font-size:18px">$25/month. Get seen first by the whole community.</p>

      <div class="feat-benefits" style="margin:20px 0">
        <div class="feat-benefit">
          <h3 data-i18n="feat.b1t">Top of your category</h3>
          <p data-i18n="feat.b1d">Your listing appears first whenever someone browses your category.</p>
        </div>
        <div class="feat-benefit">
          <h3 data-i18n="feat.b2t">Homepage carousel</h3>
          <p data-i18n="feat.b2d">A rotating spot on the home page, seen by every visitor.</p>
        </div>
        <div class="feat-benefit">
          <h3 data-i18n="feat.b3t">Featured badge</h3>
          <p data-i18n="feat.b3d">A gold badge that marks you as a community favorite.</p>
        </div>
      </div>

      <h2 class="eyebrow" data-i18n="feat.pay" style="margin-bottom:8px">How to pay</h2>
      <p data-i18n="feat.payd" style="color:var(--ink-soft)">Pay $25/month by Zelle or Venmo. Then send the request below and mention your payment — we confirm and activate your spot, usually within a day.</p>
    </section>

    <section class="block">
      <h2 class="eyebrow" data-i18n="feat.formTitle" style="margin-bottom:12px">Request featured placement</h2>
      <form id="feat-form">
        <input type="hidden" id="ft-listing" name="listingId" value={prefillId} />
        <div class="field">
          <label for="ft-biz" data-i18n="feat.biz">Business name</label>
          <input id="ft-biz" name="businessName" required maxlength="120" />
        </div>
        <div class="field">
          <label for="ft-contact" data-i18n="feat.contact">Your contact (phone or WhatsApp)</label>
          <input id="ft-contact" name="contact" required maxlength="120" inputmode="tel" />
        </div>
        <div class="field">
          <label for="ft-msg" data-i18n="feat.msg">Anything we should know (optional)</label>
          <textarea id="ft-msg" name="message" maxlength="1000" rows="2"></textarea>
        </div>
        {/* honeypot — humans never fill this */}
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-primary btn-block" type="submit">
          <span data-i18n="feat.send">Send request</span>
        </button>
        <p id="ft-msg-el" class="formmsg" hidden></p>
      </form>
    </section>
  </div>
  <script define:vars={{ prefillId, nameMap }}>
    import { t, getLang } from '../lib/i18n.js';
    if (prefillId && nameMap[prefillId]) {
      document.getElementById('ft-biz').value = nameMap[prefillId];
    }
    const form = document.getElementById('feat-form');
    const msg = document.getElementById('ft-msg-el');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.hidden = true;
      const fd = new FormData(form);
      const body = {
        type: 'featured',
        businessName: String(fd.get('businessName') || '').trim(),
        contact: String(fd.get('contact') || '').trim(),
        message: String(fd.get('message') || '').trim(),
        listingId: String(fd.get('listingId') || '') || null,
        website: String(fd.get('website') || ''), // honeypot
      };
      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'failed');
        msg.hidden = false;
        msg.className = 'formmsg ok';
        msg.textContent = t('feat.ok', getLang());
        form.reset();
      } catch (err) {
        msg.hidden = false;
        msg.className = 'formmsg err';
        msg.textContent = t('annsub.err', getLang());
      }
    });
  </script>
</Base>
<style>
  .feat-benefit { border: 1px solid color-mix(in oklab, var(--ink) 10%, transparent); border-radius: 8px; padding: 14px 16px; margin-bottom: 12px; background: var(--paper-raised); }
  .feat-benefit h3 { font-size: 16px; margin: 0 0 4px; }
  .feat-benefit h3::before { content: '★ '; color: var(--gold); }
  .feat-benefit p { margin: 0; color: var(--ink-soft); font-size: 14px; }
</style>
