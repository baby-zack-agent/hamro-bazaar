---
import Base from '../layouts/Base.astro';
import { CATEGORIES, categoryLabel } from '../lib/db.js';
---
<Base title="Admin">
  <div class="wrap">
    <section class="block">
      <h1 class="eyebrow">Admin</h1>

      <div id="login-pane">
        <p class="notice">Restricted area. Sign in with the admin key.</p>
        <form id="login-form" style="margin-top:12px">
          <div class="field">
            <label for="adm-key">Admin key</label>
            <input id="adm-key" type="password" autocomplete="current-password" required minlength="8" />
          </div>
          <button class="btn btn-primary btn-block" type="submit">Sign in</button>
          <p id="login-err" style="color:var(--maroon-deep);font-size:13px" hidden>Wrong key. Try again.</p>
        </form>
      </div>

      <div id="admin-pane" hidden>
        <div class="admin-tabs" role="tablist">
          <button class="chip" id="tab-listings" aria-pressed="true">Listings</button>
          <button class="chip" id="tab-ann" aria-pressed="false">Announcements</button>
          <button class="chip" id="tab-sub" aria-pressed="false">Submissions <span id="sub-badge"></span></button>
          <button class="chip" id="tab-analytics" aria-pressed="false">Analytics</button>
          <button class="chip" id="logout" style="margin-left:auto">Log out</button>
        </div>

        <div id="pane-listings">
          <h2 class="eyebrow">Add / edit listing</h2>
          <form id="listing-form" style="margin:12px 0 20px">
            <input type="hidden" id="lf-id" />
            <div class="field"><label for="lf-name">Name *</label><input id="lf-name" required maxlength="120" /></div>
            <div class="field"><label for="lf-cat">Category *</label>
              <select id="lf-cat">{CATEGORIES.map((c) => <option value={c}>{categoryLabel(c)}</option>)}</select>
            </div>
            <div class="field"><label for="lf-phone">Phone</label><input id="lf-phone" inputmode="tel" placeholder="(412) 555-0123" /></div>
            <div class="field"><label for="lf-addr">Address</label><input id="lf-addr" maxlength="200" /></div>
            <div class="field"><label for="lf-web">Website</label><input id="lf-web" inputmode="url" placeholder="https://…" /></div>
            <div class="field"><label for="lf-hours">Hours</label><input id="lf-hours" maxlength="200" placeholder="Mon–Sat 9am–8pm" /></div>
            <div class="field"><label for="lf-services">Services (comma separated)</label><input id="lf-services" maxlength="500" /></div>
            <div class="field"><label for="lf-langs">Languages (comma separated)</label><input id="lf-langs" maxlength="200" placeholder="Nepali, English" /></div>
            <div style="display:flex;gap:8px">
              <button class="btn btn-primary" type="submit" style="flex:1">Save listing</button>
              <button class="btn btn-ghost" type="button" id="lf-reset">Clear</button>
            </div>
            <p id="lf-msg" style="font-size:13px" hidden></p>
          </form>
          <h2 class="eyebrow">All listings (<span id="lcount">…</span>)</h2>
          <div style="overflow-x:auto">
          <table class="admin-table" id="listing-table">
            <thead><tr><th>Name</th><th>Cat</th><th>Phone</th><th>Flags</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
          </div>
        </div>

        <div id="pane-ann" hidden>
          <h2 class="eyebrow">Add announcement</h2>
          <form id="ann-form" style="margin:12px 0 20px">
            <div class="field"><label for="af-en">Title (English) *</label><input id="af-en" required maxlength="200" /></div>
            <div class="field"><label for="af-ne">Title (Nepali) *</label><input id="af-ne" required maxlength="200" /></div>
            <div class="field"><label for="af-cat">Category</label>
              <select id="af-cat">{CATEGORIES.map((c) => <option value={c}>{categoryLabel(c)}</option>)}<option value="other">Community</option></select>
            </div>
            <div style="display:flex;gap:8px">
              <button class="btn btn-primary" type="submit" style="flex:1">Publish announcement</button>
            </div>
            <p id="af-msg" style="font-size:13px" hidden></p>
          </form>
          <h2 class="eyebrow">All announcements</h2>
          <div style="overflow-x:auto">
          <table class="admin-table" id="ann-table">
            <thead><tr><th>Date</th><th>Title</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
          </div>
        </div>

        <div id="pane-sub" hidden>
          <h2 class="eyebrow">Moderation queue</h2>
          <p class="notice">Community submissions. Approving an announcement publishes it immediately; approving a review attaches it to the listing; featured requests just need your follow-up.</p>
          <div style="overflow-x:auto;margin-top:12px">
          <table class="admin-table" id="sub-table">
            <thead><tr><th>Date</th><th>Type</th><th>Summary</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody></tbody>
          </table>
          </div>
        </div>

        <div id="pane-analytics" hidden>
          <h2 class="eyebrow">Tap analytics</h2>
          <p class="notice">Privacy-first: event counts only. No personal data, IPs, or cookies are ever collected.</p>
          <div style="overflow-x:auto;margin-top:12px">
          <table class="admin-table" id="analytics-table">
            <thead><tr><th>Day</th><th>Calls</th><th>WhatsApp</th><th>Searches</th><th>Survey starts</th><th>Total taps</th></tr></thead>
            <tbody></tbody>
          </table>
          </div>
          <h2 class="eyebrow" style="margin-top:20px">Top 10 listings by taps</h2>
          <div style="overflow-x:auto">
          <table class="admin-table" id="top-table">
            <thead><tr><th>Listing</th><th>Calls</th><th>WhatsApp</th><th>Total</th></tr></thead>
            <tbody></tbody>
          </table>
          </div>
          <h2 class="eyebrow" style="margin-top:20px">Taps — last 7 days</h2>
          <div id="trend-chart" style="margin-top:8px"></div>
          <p id="analytics-msg" style="font-size:13px;color:var(--ink-faint)"></p>
        </div>
      </div>
    </section>
  </div>

<script>
const $ = (s) => document.querySelector(s);
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(path, method = 'GET', body) {
  const res = await fetch(path, {
    method,
    headers: body ? { 'Content-Type': 'application/json' } : undefined,
    body: body ? JSON.stringify(body) : undefined,
  });
  if (res.status === 401) { showLogin(); throw new Error('unauthorized'); }
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || `request failed (${res.status})`);
  return data;
}
function showLogin() { $('#login-pane').hidden = false; $('#admin-pane').hidden = true; }
function showAdmin() { $('#login-pane').hidden = true; $('#admin-pane').hidden = false; }

// --- login ---
$('#login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  $('#login-err').hidden = true;
  try {
    const res = await fetch('/api/auth', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'login', key: $('#adm-key').value }),
    });
    if (!res.ok) { $('#login-err').hidden = false; return; }
    $('#adm-key').value = '';
    showAdmin();
    await Promise.all([loadListings(), loadAnnouncements(), loadSubmissions()]);
  } catch { $('#login-err').hidden = false; }
});
$('#logout').addEventListener('click', async () => {
  await fetch('/api/auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'logout' }) }).catch(() => {});
  showLogin();
});

// --- tabs ---
const TABS = [['#tab-listings', '#pane-listings'], ['#tab-ann', '#pane-ann'], ['#tab-sub', '#pane-sub'], ['#tab-analytics', '#pane-analytics']];
for (const [tab, pane] of TABS) {
  $(tab).addEventListener('click', () => {
    for (const [t, p] of TABS) {
      $(t).setAttribute('aria-pressed', t === tab);
      $(p).hidden = p !== pane;
    }
  });
}

// --- listings ---
let listingsCache = [];
async function loadListings() {
  const data = await api('/api/admin?resource=listings');
  listingsCache = data.listings;
  $('#lcount').textContent = listingsCache.length;
  const tb = $('#listing-table tbody');
  tb.innerHTML = listingsCache.map((l) => `<tr>
    <td><strong>${esc(l.name)}</strong><br><span style="color:var(--ink-faint)">${esc(l.address || '')}</span></td>
    <td>${esc(l.category)}</td>
    <td>${esc(l.phone || '—')}</td>
    <td>${l.featured ? '★ ' : ''}${l.verified ? '✓' : ''}</td>
    <td><div class="rowbtns">
      <button class="minibtn" data-act="edit" data-id="${l.id}">Edit</button>
      <button class="minibtn ${l.featured ? 'on' : ''}" data-act="feat" data-id="${l.id}">Feat</button>
      <button class="minibtn ${l.verified ? 'ok-on' : ''}" data-act="ver" data-id="${l.id}">Ver</button>
      <button class="minibtn" data-act="del" data-id="${l.id}">Del</button>
    </div></td></tr>`).join('');
}
$('#listing-table').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act]');
  if (!btn) return;
  const id = btn.getAttribute('data-id');
  const act = btn.getAttribute('data-act');
  try {
    if (act === 'edit') {
      const l = listingsCache.find((x) => x.id === id);
      if (!l) return;
      $('#lf-id').value = l.id; $('#lf-name').value = l.name; $('#lf-cat').value = l.category;
      $('#lf-phone').value = l.phone || ''; $('#lf-addr').value = l.address || '';
      $('#lf-web').value = l.website || ''; $('#lf-hours').value = l.hours || '';
      $('#lf-services').value = (l.services || []).join(', ');
      $('#lf-langs').value = (l.languages || []).join(', ');
      $('#lf-name').focus();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (act === 'feat') {
      const l = listingsCache.find((x) => x.id === id);
      await api('/api/admin', 'POST', { action: 'featured-toggle', id, featured: !l.featured });
      await loadListings();
    } else if (act === 'ver') {
      const l = listingsCache.find((x) => x.id === id);
      await api('/api/admin', 'POST', { action: 'verify-toggle', id, verified: !l.verified });
      await loadListings();
    } else if (act === 'del') {
      const l = listingsCache.find((x) => x.id === id);
      if (confirm(`Delete "${l.name}"? This commits to GitHub immediately.`)) {
        await api('/api/admin', 'POST', { action: 'listing-delete', id });
        await loadListings();
      }
    }
  } catch (err) { alert(err.message); }
});
$('#lf-reset').addEventListener('click', () => $('#listing-form').reset());
$('#listing-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const msg = $('#lf-msg');
  msg.hidden = true;
  const body = {
    id: $('#lf-id').value || undefined,
    name: $('#lf-name').value.trim(),
    category: $('#lf-cat').value,
    phone: $('#lf-phone').value.trim(),
    address: $('#lf-addr').value.trim(),
    website: $('#lf-web').value.trim(),
    hours: $('#lf-hours').value.trim() || null,
    services: $('#lf-services').value.split(',').map((s) => s.trim()).filter(Boolean),
    languages: $('#lf-langs').value.split(',').map((s) => s.trim()).filter(Boolean),
  };
  try {
    await api('/api/admin', 'POST', { action: 'listing-save', ...body });
    msg.hidden = false;
    msg.style.color = 'var(--ok)';
    msg.textContent = 'Saved — committing to GitHub. The live site redeploys in ~1 minute.';
    $('#listing-form').reset();
    await loadListings();
  } catch (err) { msg.hidden = false; msg.style.color = 'var(--maroon-deep)'; msg.textContent = err.message; }
});

// --- announcements ---
async function loadAnnouncements() {
  const data = await api('/api/admin?resource=announcements');
  const tb = $('#ann-table tbody');
  tb.innerHTML = data.announcements.map((a) => `<tr>
    <td>${esc(a.date)}</td>
    <td>${esc(a.title?.en || '')}</td>
    <td>${a.published ? 'live' : 'draft'}</td>
    <td><div class="rowbtns">
      <button class="minibtn ${a.published ? 'on' : ''}" data-act="pub" data-id="${a.id}">${a.published ? 'Unpublish' : 'Publish'}</button>
    </div></td></tr>`).join('');
}
$('#ann-table').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act="pub"]');
  if (!btn) return;
  try {
    const id = btn.getAttribute('data-id');
    const cur = btn.textContent.trim() === 'Unpublish';
    await api('/api/admin', 'POST', { action: 'announcement-publish', id, published: !cur });
    await loadAnnouncements();
  } catch (err) { alert(err.message); }
});
$('#ann-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const msg = $('#af-msg');
  msg.hidden = true;
  try {
    await api('/api/admin', 'POST', {
      action: 'announcement-add',
      title_en: $('#af-en').value.trim(),
      title_ne: $('#af-ne').value.trim(),
      category: $('#af-cat').value,
      published: true,
    });
    msg.hidden = false; msg.style.color = 'var(--ok)';
    msg.textContent = 'Published — committing to GitHub.';
    $('#ann-form').reset();
    await loadAnnouncements();
  } catch (err) { msg.hidden = false; msg.style.color = 'var(--maroon-deep)'; msg.textContent = err.message; }
});

// --- submissions (moderation queue) ---
function subSummary(s) {
  if (s.type === 'announcement') return `<strong>${esc(s.businessName)}</strong><br>${esc(s.title)}${s.details ? `<br><span style="color:var(--ink-faint)">${esc(s.details.slice(0, 120))}</span>` : ''}<br><span style="color:var(--ink-faint)">contact: ${esc(s.contact || '—')}</span>`;
  if (s.type === 'review') return `<strong>${esc(s.name)}</strong> rated ${'★'.repeat(s.rating)}<br>${esc(s.text.slice(0, 160))}<br><span style="color:var(--ink-faint)">listing: ${esc(s.listingId)}</span>`;
  if (s.type === 'featured-request') return `<strong>${esc(s.businessName)}</strong><br><span style="color:var(--ink-faint)">contact: ${esc(s.contact || '—')}</span>${s.message ? `<br>${esc(s.message.slice(0, 160))}` : ''}${s.listingId ? `<br><span style="color:var(--ink-faint)">listing: ${esc(s.listingId)}</span>` : ''}`;
  return esc(s.id);
}
async function loadSubmissions() {
  const data = await api('/api/admin?resource=submissions');
  const tb = $('#sub-table tbody');
  const pending = data.submissions.filter((s) => s.status === 'pending').length;
  $('#sub-badge').textContent = pending ? `(${pending})` : '';
  tb.innerHTML = data.submissions.map((s) => `<tr>
    <td>${esc((s.created || '').slice(0, 10))}</td>
    <td>${esc(s.type)}</td>
    <td>${subSummary(s)}</td>
    <td>${esc(s.status)}</td>
    <td>${s.status === 'pending' ? `<div class="rowbtns">
      <button class="minibtn ok-on" data-act="approve" data-id="${s.id}">Approve</button>
      <button class="minibtn" data-act="reject" data-id="${s.id}">Reject</button>
    </div>` : '—'}</td></tr>`).join('') || '<tr><td colspan="5">Queue is empty.</td></tr>';
}
$('#sub-table').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act]');
  if (!btn) return;
  const id = btn.getAttribute('data-id');
  const act = btn.getAttribute('data-act');
  try {
    await api('/api/admin', 'POST', { action: 'submission-moderate', id, decision: act });
    await loadSubmissions();
  } catch (err) { alert(err.message); }
});

// --- analytics ---
// Reads the public analytics/*.jsonl files straight from GitHub (repo is
// public, no auth needed) and aggregates client-side. Listing names come
// from the already-authed listings fetch.
const ANALYTICS_REPO = 'baby-zack-agent/hamro-bazaar';
async function loadAnalytics() {
  const msg = $('#analytics-msg');
  msg.textContent = 'Loading…';
  try {
    if (!listingsCache.length) {
      const d = await api('/api/admin?resource=listings');
      listingsCache = d.listings;
    }
    const names = {};
    for (const l of listingsCache) names[l.id] = l.name;
    const dirRes = await fetch(`https://api.github.com/repos/${ANALYTICS_REPO}/contents/analytics?ref=main`);
    let files = [];
    if (dirRes.ok) {
      const dir = await dirRes.json();
      files = (Array.isArray(dir) ? dir : [])
        .filter((f) => /\.jsonl$/.test(f.name))
        .sort((a, b) => (a.name < b.name ? 1 : -1));
    }
    const days = [];
    for (const f of files.slice(0, 14)) {
      const day = f.name.replace('events-', '').replace('.jsonl', '');
      let text = '';
      try { const r = await fetch(f.download_url); if (r.ok) text = await r.text(); } catch {}
      const counts = { call_tap: 0, whatsapp_tap: 0, search: 0, survey_start: 0 };
      const perListing = {};
      for (const line of text.split('\n')) {
        if (!line.trim()) continue;
        let ev; try { ev = JSON.parse(line); } catch { continue; }
        if (counts[ev.event] === undefined) continue;
        counts[ev.event]++;
        if ((ev.event === 'call_tap' || ev.event === 'whatsapp_tap') && ev.listingId) {
          const p = perListing[ev.listingId] || (perListing[ev.listingId] = { call_tap: 0, whatsapp_tap: 0 });
          p[ev.event]++;
        }
      }
      days.push({ day, counts, perListing });
    }
    $('#analytics-table tbody').innerHTML = days.map(({ day, counts }) => `<tr>
      <td><strong>${esc(day)}</strong></td><td>${counts.call_tap}</td><td>${counts.whatsapp_tap}</td>
      <td>${counts.search}</td><td>${counts.survey_start}</td>
      <td><strong>${counts.call_tap + counts.whatsapp_tap}</strong></td></tr>`).join('')
      || '<tr><td colspan="6">No analytics yet — events appear here after the first taps.</td></tr>';
    const agg = {};
    for (const { perListing } of days) for (const [id, c] of Object.entries(perListing)) {
      const a = agg[id] || (agg[id] = { call_tap: 0, whatsapp_tap: 0 });
      a.call_tap += c.call_tap; a.whatsapp_tap += c.whatsapp_tap;
    }
    const top = Object.entries(agg)
      .sort((a, b) => (b[1].call_tap + b[1].whatsapp_tap) - (a[1].call_tap + a[1].whatsapp_tap))
      .slice(0, 10);
    $('#top-table tbody').innerHTML = top.map(([id, c]) => `<tr>
      <td>${esc(names[id] || id)}</td><td>${c.call_tap}</td><td>${c.whatsapp_tap}</td>
      <td><strong>${c.call_tap + c.whatsapp_tap}</strong></td></tr>`).join('')
      || '<tr><td colspan="4">No taps recorded yet.</td></tr>';
    const last7 = days.slice(0, 7).reverse();
    const max = Math.max(1, ...last7.map(({ counts }) => counts.call_tap + counts.whatsapp_tap));
    const W = 320, H = 92, bw = Math.floor(W / 7);
    const bars = last7.map(({ day, counts }, i) => {
      const v = counts.call_tap + counts.whatsapp_tap;
      const h = Math.round((v / max) * (H - 22));
      const x = i * bw + 6, bw2 = bw - 12;
      return `<rect x="${x}" y="${H - 16 - h}" width="${bw2}" height="${h}" rx="2" fill="var(--maroon)"/>`
        + `<text x="${x + bw2 / 2}" y="${H - 4}" font-size="9" text-anchor="middle" fill="var(--ink-faint)">${esc(day.slice(5))}</text>`
        + (v ? `<text x="${x + bw2 / 2}" y="${H - 20 - h}" font-size="9" text-anchor="middle" fill="var(--ink-soft)">${v}</text>` : '');
    }).join('');
    $('#trend-chart').innerHTML = last7.length
      ? `<svg viewBox="0 0 ${W} ${H}" style="max-width:360px;width:100%" role="img" aria-label="Taps per day, last 7 days">${bars}</svg>`
      : '<p style="font-size:13px;color:var(--ink-faint)">No data yet.</p>';
    msg.textContent = days.length ? `Showing ${days.length} day(s) of analytics (newest first).` : '';
  } catch (err) {
    msg.textContent = 'Could not load analytics: ' + err.message;
  }
}

// If we already have a session cookie, skip the login form.
api('/api/admin?resource=listings').then(() => { showAdmin(); return Promise.all([loadListings(), loadAnnouncements(), loadSubmissions(), loadAnalytics()]); }).catch(() => showLogin());
</script>
</Base>
