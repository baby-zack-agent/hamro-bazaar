---
import { categoryLabel } from '../lib/db.js';
import { telLink, waLink, waGreeting } from '../lib/format.js';

const { listing, lang = 'en' } = Astro.props;
const tel = telLink(listing.phone);
const wa = waLink(listing.phone, waGreeting(listing, lang));
// Rating row renders only when real rating data exists — never invented.
const rating = typeof listing.rating === 'number' ? listing.rating : null;
const reviewCount = typeof listing.reviewCount === 'number' ? listing.reviewCount : null;
---
<article class:list={['lcard', listing.featured && 'lcard-featured']}>
  <div class="card-top">
    <span class="card-cat">{categoryLabel(listing.category, lang)}</span>
    <span class="badges">
      {listing.featured && <span class="badge badge-gold" data-i18n="badge.featured">Featured</span>}
      {listing.verified && <span class="badge badge-ok" data-i18n="badge.verified">Verified</span>}
    </span>
  </div>
  <h3><a class="cardlink" href={`/business/${listing.id}`}>{listing.name}</a></h3>
  {rating !== null && (
    <p class="card-rating">
      {rating.toFixed(1)} <span class="stars" aria-hidden="true">{'★'.repeat(Math.round(rating))}{'☆'.repeat(5 - Math.round(rating))}</span>
      {reviewCount !== null && <span> · {reviewCount} reviews</span>}
    </p>
  )}
  {listing.address && <p class="card-addr">{listing.address}</p>}
  <div class="card-actions">
    {tel ? (
      <a class="btn btn-primary" href={tel} data-listing-id={listing.id} data-track-context="card"><span data-i18n="card.call">Call</span></a>
    ) : (
      <span class="nophone" data-i18n="card.noPhone">phone not listed</span>
    )}
    {wa && <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener" data-listing-id={listing.id} data-track-context="card">WhatsApp</a>}
  </div>
</article>
