---
import { categoryLabel } from '../lib/db.js';

// Pure markup. Pages that list announcements include one shared JSON blob
// (#hb-ann-data) + one rerender script for the language toggle.
const { announcement, lang = 'en' } = Astro.props;
const title = announcement.title?.[lang] || announcement.title?.en || '';
---
<article class="acard" data-ann={announcement.id}>
  <div class="when">{announcement.date} · {categoryLabel(announcement.category, lang)}</div>
  {announcement.businessName && <div class="who">{announcement.businessName}</div>}
  <p class="atitle">{title}</p>
  {announcement.details && <p class="adetails">{announcement.details}</p>}
</article>
<style>
  .who { font-weight: 600; font-size: 14px; margin: 2px 0 0; }
  .adetails { color: var(--ink-soft); font-size: 14px; margin: 4px 0 0; }
</style>
