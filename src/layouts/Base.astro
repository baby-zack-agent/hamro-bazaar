---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

const { title = 'Hamro Bazaar', tab = '' } = Astro.props;
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';

const nav = [
  { id: 'home', href: '/', key: 'nav.home', label: 'Home' },
  { id: 'browse', href: '/browse', key: 'nav.browse', label: 'Browse' },
  { id: 'announcements', href: '/announcements', key: 'nav.announcements', label: 'Announcements' },
  { id: 'request', href: '/request', key: 'nav.request', label: 'Request' },
];
// Preloaded woff2 URLs are pinned to the css2 response for
// 'Tiro Devanagari Hindi' 400 (latin + devanagari subsets).
const fontCss = 'https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi:ital@0;1&display=swap';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Hamro Bazaar</title>
  <meta name="description" content="Every Nepali & Indian service in Pittsburgh. One search." />
  <meta name="theme-color" content="#8c2b2b" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Hamro Bazaar" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/svg+xml" href="/icons/icon-192.svg" />
  <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
  <!-- ViewTransitions (app-feel): native-style page changes, no white flash.
       Degrades gracefully — plain navigation where unsupported. -->
  <ViewTransitions />
  <!-- Display face: Tiro Devanagari Hindi (real Google Fonts family with native
       Devanagari — the spec's 'Tiro Devanagari Serif' 404s). One face only. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://fonts.gstatic.com/s/tirodevanagarihindi/v7/55xyezN7P8T4e0_CfIJrwdodg9HoYw0i-M9vT-MPXm4I3Q.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://fonts.gstatic.com/s/tirodevanagarihindi/v7/55xyezN7P8T4e0_CfIJrwdodg9HoYw0i-M9vTuMPXm4I3X_o.woff2" />
  <link rel="stylesheet" href={fontCss} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={fontCss} /></noscript>
  <script>document.documentElement.classList.add('js');</script>
  <!-- === PWA INSTALLABILITY (Worker 1) — PNG icons, iOS splash screens.
       PNG apple-touch-icon placed after the SVG one above so iOS (which
       ignores SVG) picks this up. SVG favicon stays as fallback. === -->
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="apple-touch-startup-image" href="/splash/splash-1170x2532.png"
        media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/splash-1290x2796.png"
        media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/splash-1125x2436.png"
        media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/splash-1242x2688.png"
        media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/splash-828x1792.png"
        media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" />
</head>
<body data-wa-number={waNumber}>
  <header class="site-header" id="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="Hamro Bazaar home">
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="2" y="2" width="28" height="28" rx="7" fill="#8c2b2b"/>
          <path d="M8 13h16l-2.2 8.2a2 2 0 0 1-1.9 1.5H12a2 2 0 0 1-1.9-1.5L8 13z" fill="none" stroke="#c6a15b" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M10 13c0-3.5 2.7-6 6-6s6 2.5 6 6" fill="none" stroke="#c6a15b" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span class="word">
          <span class="brand-name" data-i18n="brand.name">Hamro Bazaar</span>
          <span class="brand-tag" data-i18n="brand.tag">Pittsburgh pilot</span>
        </span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        {nav.map((n) => (
          <a class="navlink" href={n.href} aria-current={tab === n.id ? 'page' : undefined}>
            <span data-i18n={n.key}>{n.label}</span>
          </a>
        ))}
        <a class="btn btn-primary btn-sm" href="/list-business">
          <span data-i18n="band.cta">List your business — free</span>
        </a>
      </nav>
      <button class="lang-toggle" data-lang-toggle aria-pressed="false" aria-label="Switch language / भाषा परिवर्तन">
        <span data-lang-label>ने</span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="fgrid">
        <div>
          <span class="fname" data-i18n="brand.name">Hamro Bazaar</span>
          <p data-i18n="foot.tag">Hamro Bazaar · Pittsburgh pilot concept</p>
          <p class="ffine" data-i18n="foot.made">Built for the Nepali & Indian community of Pittsburgh.</p>
        </div>
        <nav aria-label="Explore">
          <h3 data-i18n="foot.explore">Explore</h3>
          <ul>
            <li><a href="/"><span data-i18n="nav.home">Home</span></a></li>
            <li><a href="/browse"><span data-i18n="nav.browse">Browse</span></a></li>
            <li><a href="/announcements"><span data-i18n="nav.announcements">Announcements</span></a></li>
            <li><a href="/request"><span data-i18n="nav.request">Request</span></a></li>
          </ul>
        </nav>
        <nav aria-label="For owners">
          <h3 data-i18n="foot.owners">For owners</h3>
          <ul>
            <li><a href="/list-business"><span data-i18n="band.cta">List your business — free</span></a></li>
            <li><a href="/feature"><span data-i18n="band.feat">Get featured — $25/mo</span></a></li>
          </ul>
        </nav>
      </div>
    </div>
  </footer>

  <nav class="tabbar" aria-label="Primary">
    {nav.map((n, i) => (
      <a href={n.href} aria-current={tab === n.id ? 'page' : undefined}>
        {i === 0 && <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></svg>}
        {i === 1 && <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>}
        {i === 2 && <svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4V5z"/></svg>}
        {i === 3 && <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>}
        <span data-i18n={n.key}>{n.label}</span>
      </a>
    ))}
  </nav>

  <script>
    import { getLang, setLang, applyLang } from '../lib/i18n.js';
    import { track } from '../lib/analytics.js';

    // App-feel note: ViewTransitions re-executes this script on each
    // navigation. Everything below is idempotent: document-level listeners
    // bind exactly once, per-navigation work (lang, reveal, header state)
    // re-runs against the fresh DOM.
    const HB = (window.__hbBase ??= {});

    // Tap analytics: delegated, fire-and-forget. Catches every tel:/wa.me
    // link on the site — server-rendered cards, live-search results, and any
    // future links — without touching each template's click handling.
    if (!HB.clickBound) {
      document.addEventListener('click', (e) => {
        try {
          const a = e.target.closest('a[href^="tel:"], a[href^="https://wa.me"]');
          if (!a) return;
          const href = a.getAttribute('href') || '';
          track(href.startsWith('tel:') ? 'call_tap' : 'whatsapp_tap', {
            listingId: a.getAttribute('data-listing-id') || null,
            context: a.getAttribute('data-track-context') || null,
          });
        } catch { /* never break navigation */ }
      }, { capture: true });
      HB.clickBound = true;
    }

    function initPage() {
      // Solid-on-scroll header: hairline appears after 8px (no backdrop-filter —
      // iOS Safari ghosts blurred sticky headers). Node is re-grabbed each
      // navigation because view transitions swap the body.
      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      if (!HB.scrollBound) {
        window.addEventListener('scroll', onScroll, { passive: true });
        HB.scrollBound = true;
      }
      onScroll();

      // Language: re-apply on each navigation; bind fresh toggle nodes only.
      applyLang(getLang());
      // Page-level dynamic strings (e.g. the survey's interpolated "{n}"
      // counter) must be refreshed after applyLang clobbers them.
      try { window.__hbSurveyRefresh?.(); } catch {}
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        if (btn.dataset.hbBound) return;
        btn.dataset.hbBound = '1';
        btn.addEventListener('click', () => {
          const next = getLang() === 'ne' ? 'en' : 'ne';
          setLang(next);
        });
      });

      // Section-head reveal only (everything else stays still).
      // Fallback timer guarantees content appears even if IO never fires.
      const reveal = () => document.querySelectorAll('.rv:not(.in)').forEach((el) => el.classList.add('in'));
      if ('IntersectionObserver' in window) {
        HB.io ??= new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); HB.io.unobserve(e.target); } });
        }, { threshold: 0.15 });
        document.querySelectorAll('.rv:not([data-hb-rv])').forEach((el) => { el.dataset.hbRv = '1'; HB.io.observe(el); });
        setTimeout(reveal, 2500);
      } else {
        reveal();
      }
    }
    initPage();
    if (!HB.pageLoadBound) {
      document.addEventListener('astro:page-load', initPage);
      HB.pageLoadBound = true;
    }

    // Best-effort service worker — must never break the page.
    if (!HB.swBound) {
      HB.swBound = true;
      try {
        if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      } catch { /* offline support is a bonus, not a requirement */ }
    }
  </script>
  <!-- === PWA INSTALLABILITY (Worker 1) — install prompts + standalone detection === -->
  <script src="/js/pwa-install.js" defer></script>
</body>
</html>
