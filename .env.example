# Copy to .env (local dev) or set in Vercel project settings. NEVER commit real values.
# Admin session password for /admin. Pick a long random string.
ADMIN_KEY=change-me-to-a-long-random-string
# GitHub personal access token with `repo` (contents: write) scope, used by /api/admin/*
# to commit data changes. Stored server-side only — never exposed to the client.
GITHUB_TOKEN=
# Optional overrides (defaults shown)
GITHUB_REPO=baby-zack-agent/hamro-bazaar
GITHUB_BRANCH=main
# Public WhatsApp number used for "Request a service" + "List your business" deep links,
# in international format WITHOUT the leading + (e.g. 14125550123).
PUBLIC_WHATSAPP_NUMBER=
